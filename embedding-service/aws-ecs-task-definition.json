{
  "family": "embedding-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::252334401567:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::252334401567:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "embedding-service",
      "image": "ojochegbe/embedding-service:latest",
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "EMBEDDING_MODEL",
          "value": "all-MiniLM-L6-v2"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/embedding-service",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8000/health || exit 1"],
        "interval": 60,
        "timeout": 30,
        "retries": 5,
        "startPeriod": 300
      }
    }
  ]
} 